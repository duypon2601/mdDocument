# Temporal
INGEST_TEMPORAL_ADDRESS=localhost:7233
INGEST_TEMPORAL_NAMESPACE=default
INGEST_INGEST_TQ=ingest-tq
INGEST_CONVERT_TQ=convert-tq
INGEST_INDEX_TQ=index-tq

# Postgres lưu metadata (compose map ra cổng 5433)
INGEST_DATABASE_URL=postgresql+psycopg://ingest:ingest@localhost:5433/ingest

# MinIO / S3 (compose cũng đọc key và bucket từ đây)
INGEST_S3_ENDPOINT=http://localhost:9000
INGEST_S3_ACCESS_KEY=minioadmin
INGEST_S3_SECRET_KEY=minioadmin
INGEST_S3_BUCKET=ingest
INGEST_S3_REGION=us-east-1

# Qdrant
INGEST_QDRANT_URL=http://localhost:6333
INGEST_QDRANT_COLLECTION=documents

# Embedding (API tương thích OpenAI, ví dụ Ollama)
INGEST_EMBED_BASE_URL=http://localhost:11434/v1
# Container (docker compose --profile app) dùng biến này, mặc định host.docker.internal
# INGEST_DOCKER_EMBED_BASE_URL=http://host.docker.internal:11434/v1
INGEST_EMBED_API_KEY=none
INGEST_EMBED_MODEL=bge-m3
INGEST_EMBED_DIM=1024
INGEST_EMBED_MAX_TOKENS=8192

# Chunking
INGEST_CHUNK_TOKENS=512
INGEST_CHUNK_OVERLAP=64
INGEST_CHUNK_BATCH_SIZE=100

# OCR
INGEST_OCR_PAGES_PER_BATCH=10
# Tesseract cần gói vie (macOS: brew install tesseract-lang)
INGEST_OCR_LANG=vie+eng
INGEST_MIN_OCR_CONFIDENCE=0.6
INGEST_REVIEW_ENABLED=false

# Ảnh trong file Word: auto | ocr | vision
INGEST_DOCX_IMAGE_MODE=auto
INGEST_DOCX_MIN_IMAGE_BYTES=2048
# xlsx: thêm bảng công thức nguyên văn kèm giá trị đã tính
INGEST_XLSX_FORMULAS=true

# Vision LLM đọc biểu đồ/bảng trong ảnh (để trống model là tắt)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  model gemini-2.5-flash
# OpenAI: https://api.openai.com/v1  model gpt-4o
# Ollama: http://localhost:11434/v1  model qwen2.5vl
INGEST_VISION_BASE_URL=http://localhost:11434/v1
INGEST_VISION_API_KEY=none
INGEST_VISION_MODEL=
INGEST_VISION_TIMEOUT=120

# Worker
INGEST_CONVERT_MAX_CONCURRENT_ACTIVITIES=4
INGEST_INDEX_MAX_ACTIVITIES_PER_SECOND=5.0

# API
INGEST_MAX_UPLOAD_BYTES=104857600
INGEST_API_URL=http://localhost:8000

# Cổng host cho docker compose (đổi khi máy đã có service khác chiếm cổng)
INGEST_PG_HOST_PORT=5433
INGEST_TEMPORAL_HOST_PORT=7233
INGEST_TEMPORAL_UI_HOST_PORT=8080
INGEST_MINIO_HOST_PORT=9000
INGEST_MINIO_CONSOLE_HOST_PORT=9001
INGEST_QDRANT_HOST_PORT=6333
INGEST_API_HOST_PORT=8000

@startuml
title <size:24>Container View: Document Ingestion System</size>\n<size:24>Level 2 - Container (Temporal)</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Temporal", $bgColor="#5b3fa0", $borderColor="#3f2c70", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,WebBrowser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(NgườidùngNghiệpvụ, "Người dùng / Nghiệp vụ", $descr="Tải tài liệu lên, theo dõi tiến độ, duyệt tài liệu OCR kém", $tags="Person", $link="")
Person(Quảntrịviên, "Quản trị viên", $descr="Cấu hình pipeline, xem lịch sử job, retry hoặc huỷ job lỗi", $tags="Person", $link="")
System(Nguồntàiliệu, "Nguồn tài liệu", $descr="File share, SharePoint, Google Drive, email… (tùy chọn, đồng bộ tự động)", $tags="Software System,External", $link="")
System(EmbeddingModelProvider, "Embedding Model Provider", $descr="API hoặc model local tạo vector (OpenAI, Voyage, bge-m3…)", $tags="Software System,External", $link="")
System(OCRVisionModel, "OCR / Vision Model", $descr="Đọc chữ từ ảnh và PDF scan (Tesseract, PaddleOCR hoặc VLM)", $tags="Software System,External", $link="")
System(ỨngdụngRAGSearch, "Ứng dụng RAG / Search", $descr="Chatbot, trích xuất thông tin, tìm kiếm ngữ nghĩa", $tags="Software System,External", $link="")

System_Boundary("DocumentIngestionSystem_boundary", "Document Ingestion System", $tags="Software System") {
  Container(DocumentIngestionSystem.TemporalServer, "Temporal Server", $techn="Temporal (self-hosted, PostgreSQL riêng) hoặc Temporal Cloud", $descr="Lưu lịch sử từng bước của workflow, quản lý task queue, timer, retry; kèm Temporal Web UI", $tags="Container,Temporal", $link="")
  Container(DocumentIngestionSystem.ConversionWorker, "Conversion Worker", $techn="Python, temporalio worker, task queue convert-tq", $descr="Chạy activity chuyển file gốc sang Markdown. Scale theo CPU/GPU", $tags="Container", $link="")
  Container(DocumentIngestionSystem.IndexingWorker, "Indexing Worker", $techn="Python, temporalio worker, task queue ingest-tq và index-tq", $descr="Chạy code workflow (điều phối các bước, chờ signal, ghi trạng thái) và activity chia chunk, tạo embedding, ghi Vector DB. Một tiến trình, hai Worker. Scale theo rate limit của embedding API", $tags="Container", $link="")
  ContainerDb(DocumentIngestionSystem.ObjectStorage, "Object Storage", $techn="MinIO / S3", $descr="File gốc, Markdown trung gian và cuối, chunk JSONL, ảnh trích xuất", $tags="Container,Database", $link="")
  ContainerDb(DocumentIngestionSystem.MetadataDB, "Metadata DB", $techn="PostgreSQL", $descr="Danh mục tài liệu, trạng thái nghiệp vụ, hash, index_version", $tags="Container,Database", $link="")
  ContainerDb(DocumentIngestionSystem.VectorDB, "Vector DB", $techn="Qdrant (hoặc pgvector, Milvus)", $descr="Vector + payload: text chunk, doc_id, heading, trang, index_version", $tags="Container,Database", $link="")
  Container(DocumentIngestionSystem.WebUICLI, "Web UI / CLI", $techn="React hoặc Typer CLI", $descr="Upload, xem tiến độ, duyệt tài liệu, bấm re-index", $tags="Container,WebBrowser", $link="")
  Container(DocumentIngestionSystem.IngestionAPI, "Ingestion API", $techn="Python, FastAPI, temporalio client", $descr="Nhận file, kiểm tra, lưu bản gốc, khởi động workflow, trả trạng thái", $tags="Container", $link="")
}

Rel(NgườidùngNghiệpvụ, DocumentIngestionSystem.WebUICLI, "Upload, theo dõi, duyệt", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, DocumentIngestionSystem.WebUICLI, "Cấu hình, re-index", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, DocumentIngestionSystem.TemporalServer, "Xem lịch sử, retry, terminate qua Temporal UI", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Nguồntàiliệu, DocumentIngestionSystem.IngestionAPI, "Đẩy tài liệu mới", $techn="Webhook", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.WebUICLI, DocumentIngestionSystem.IngestionAPI, "Gọi API", $techn="REST/JSON", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.ObjectStorage, "Lưu file gốc", $techn="S3 API", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.MetadataDB, "Tạo document, đọc danh sách", $techn="SQL", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.TemporalServer, "Start workflow, query, signal, cancel", $techn="gRPC", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, DocumentIngestionSystem.TemporalServer, "Nhận activity task, heartbeat, trả kết quả", $techn="gRPC, convert-tq", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, DocumentIngestionSystem.ObjectStorage, "Đọc file gốc, ghi Markdown", $techn="S3 API", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, OCRVisionModel, "OCR trang ảnh", $techn="HTTPS / local", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.TemporalServer, "Nhận workflow task và activity task, trả kết quả", $techn="gRPC, ingest-tq + index-tq", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.MetadataDB, "Cập nhật trạng thái", $techn="SQL", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.ObjectStorage, "Đọc Markdown, ghi/đọc chunk", $techn="S3 API", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, EmbeddingModelProvider, "Tạo embedding", $techn="HTTPS", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.VectorDB, "Upsert, xóa bản cũ", $techn="gRPC", $tags="Relationship", $link="")
Rel(ỨngdụngRAGSearch, DocumentIngestionSystem.VectorDB, "Tìm kiếm vector", $techn="gRPC", $tags="Relationship", $link="")
Rel(ỨngdụngRAGSearch, DocumentIngestionSystem.ObjectStorage, "Lấy Markdown gốc khi cần", $techn="S3 API", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
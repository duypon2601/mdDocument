@startuml
title <size:24>Dynamic View: Document Ingestion System</size>\n<size:24>Luồng xử lý một tài liệu qua Temporal</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Temporal", $bgColor="#5b3fa0", $borderColor="#3f2c70", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,WebBrowser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

System_Boundary("DocumentIngestionSystem_boundary", "Document Ingestion System", $tags="Software System") {
  Container(DocumentIngestionSystem.TemporalServer, "Temporal Server", $techn="Temporal (self-hosted, PostgreSQL riêng) hoặc Temporal Cloud", $descr="Lưu lịch sử từng bước của workflow, quản lý task queue, timer, retry; kèm Temporal Web UI", $tags="Container,Temporal", $link="")
  Container(DocumentIngestionSystem.ConversionWorker, "Conversion Worker", $techn="Package ingest-convert (packages/convert). Python, temporalio worker, task queue convert-tq", $descr="Chạy activity chuyển file gốc sang Markdown. Scale theo CPU/GPU", $tags="Container", $link="")
  Container(DocumentIngestionSystem.IndexingWorker, "Indexing Worker", $techn="Package ingest-index (packages/index). Python, temporalio worker, task queue ingest-tq và index-tq", $descr="Chạy code workflow (điều phối các bước, chờ signal, ghi trạng thái) và activity chia chunk, tạo embedding, ghi Vector DB. Một tiến trình, hai Worker. Scale theo rate limit của embedding API", $tags="Container", $link="")
  ContainerDb(DocumentIngestionSystem.ObjectStorage, "Object Storage", $techn="MinIO / S3", $descr="File gốc, Markdown trung gian và cuối, chunk JSONL, ảnh trích xuất", $tags="Container,Database", $link="")
  ContainerDb(DocumentIngestionSystem.MetadataDB, "Metadata DB", $techn="PostgreSQL", $descr="Danh mục tài liệu, trạng thái nghiệp vụ, hash, index_version", $tags="Container,Database", $link="")
  ContainerDb(DocumentIngestionSystem.VectorDB, "Vector DB", $techn="Qdrant (hoặc pgvector, Milvus)", $descr="Vector + payload: text chunk, doc_id, heading, trang, index_version", $tags="Container,Database", $link="")
  Container(DocumentIngestionSystem.WebUICLI, "Web UI / CLI", $techn="React SPA (thư mục web/, build tĩnh vào packages/api) do ingest-api phục vụ ở GET /, Typer CLI (package ingest-cli)", $descr="Upload, xem tiến độ, duyệt tài liệu, xem Markdown và chunk, tìm kiếm thử. Re-index chỉ có ở CLI", $tags="Container,WebBrowser", $link="")
  Container(DocumentIngestionSystem.IngestionAPI, "Ingestion API", $techn="Package ingest-api (packages/api). Python, FastAPI, temporalio client", $descr="Nhận file, kiểm tra, lưu bản gốc, khởi động workflow, trả trạng thái", $tags="Container", $link="")
}

System(EmbeddingModelProvider, "Embedding Model Provider", $descr="API hoặc model local tạo vector (OpenAI, Voyage, bge-m3…)", $tags="Software System,External", $link="")
System(OCRVisionModel, "OCR / Vision Model", $descr="Đọc chữ từ ảnh và PDF scan (Tesseract, PaddleOCR hoặc VLM)", $tags="Software System,External", $link="")

Rel(DocumentIngestionSystem.WebUICLI, DocumentIngestionSystem.IngestionAPI, "1: Upload file", $techn="REST/JSON", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.ObjectStorage, "2: PUT raw/{doc_id}/", $techn="S3 API", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.MetadataDB, "3: INSERT document (RECEIVED)", $techn="SQL", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IngestionAPI, DocumentIngestionSystem.TemporalServer, "4: start_workflow(id=ingest-{doc_id})", $techn="gRPC", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.TemporalServer, "5: Nhận workflow task (ingest-tq), đặt lịch detect / parse / OCR", $techn="gRPC, ingest-tq + index-tq", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, DocumentIngestionSystem.TemporalServer, "6: Nhận activity convert", $techn="gRPC, convert-tq", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, DocumentIngestionSystem.ObjectStorage, "7: Đọc raw, ghi md/{doc_id}.md", $techn="S3 API", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.ConversionWorker, OCRVisionModel, "8: OCR trang scan (nếu có)", $techn="HTTPS / local", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.MetadataDB, "9: status = CONVERTED", $techn="SQL", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.TemporalServer, "10: Nhận activity index", $techn="gRPC, ingest-tq + index-tq", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, EmbeddingModelProvider, "11: Embed theo lô", $techn="HTTPS", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.VectorDB, "12: Upsert, xóa version cũ", $techn="gRPC", $tags="Relationship", $link="")
Rel(DocumentIngestionSystem.IndexingWorker, DocumentIngestionSystem.MetadataDB, "13: status = INDEXED", $techn="SQL", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
@startuml
title <size:24>Container View: OpenRAG Platform</size>\n<size:24>Level 2 - Container: Kiến trúc container OpenRAG</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,WebBrowser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Ngườidùng, "Người dùng", $descr="Đăng nhập tài khoản, quản lý tài liệu trong workspace, tra cứu tri thức qua chat, nhận câu trả lời có trích dẫn nguồn và biểu đồ phân tích", $tags="Person", $link="")
Person(Quảntrịviên, "Quản trị viên", $descr="Quản lý tổ chức, phân quyền RBAC, đăng ký mô hình LLM, giám sát hạn ngạch token và đánh giá chất lượng RAG", $tags="Person", $link="")
System(LLMVLMProvider, "LLM / VLM Provider", $descr="Cung cấp mô hình ngôn ngữ lớn (OpenAI GPT-5.6, Azure OpenAI, Anthropic, Bedrock, vLLM, Ollama) qua thư viện LiteLLM nhúng trong tiến trình", $tags="Software System,External", $link="")
System(ObservabilityPlatform, "Observability Platform", $descr="Hạ tầng giám sát OpenTelemetry thu thập traces, metrics và logs (Prometheus, Grafana, Loki, Tempo)", $tags="Software System,External", $link="")

System_Boundary("OpenRAGPlatform_boundary", "OpenRAG Platform", $tags="Software System") {
  Container(OpenRAGPlatform.CeleryWorkerFleet, "Celery Worker Fleet", $techn="Python 3.12, Celery, Docling, RapidOCR, LiteLLM", $descr="Cụm worker nền đa hàng đợi: xử lý trích xuất Docling/OCR, chia chunk, sinh embedding, đánh giá golden dataset và thăm dò model", $tags="Container", $link="")
  Container(OpenRAGPlatform.CeleryBeatScheduler, "Celery Beat Scheduler", $techn="Python 3.12, Celery Beat", $descr="Bộ lập lịch tác vụ định kỳ: điều phối quét tác vụ đến hạn, dọn tài liệu kẹt và kích hoạt backfill làm giàu dữ liệu", $tags="Container", $link="")
  Container(OpenRAGPlatform.EventWorker, "Event Worker", $techn="Python 3.12, Celery / Async Worker, Redis Streams", $descr="Tiến trình tiêu thụ sự kiện bền vững từ Redis Streams, đảm bảo mẫu Transactional Outbox xử lý tin cậy và không mất dữ liệu", $tags="Container", $link="")
  ContainerDb(OpenRAGPlatform.RelationalDatabase, "Relational Database", $techn="PostgreSQL 16 Alpine", $descr="Lưu trữ metadata tài liệu, tổ chức, workspace, tài khoản người dùng, bảng phân quyền RBAC, phiên chat, bằng chứng trích dẫn và khóa mã hóa", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.MessageBrokerCache, "Message Broker & Cache", $techn="Redis 7 Alpine", $descr="Hàng đợi tác vụ Celery (default, interactive, ingestion, models...), cache phiên và bộ đếm giới hạn tốc độ", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.TransactionalEventStore, "Transactional Event Store", $techn="Redis 7.4 Alpine (Streams, AOF always)", $descr="Lưu trữ luồng sự kiện bền vững qua Redis Streams với cơ chế append-only file (AOF always)", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.ObjectStorage, "Object Storage", $techn="MinIO (S3 compatible)", $descr="Lưu trữ tài liệu gốc, vùng cách ly kiểm duyệt file (quarantine), và dữ liệu xuất báo cáo", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.VectorDatabase, "Vector Database", $techn="Qdrant Vector DB", $descr="Lưu trữ vector dense và sparse BM25, hỗ trợ tìm kiếm kết hợp (hybrid search) với bộ lọc cứng cô lập tenant theo org_id và workspace_id", $tags="Container,Database", $link="")
  Container(OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Text Embeddings Inference (TEI)", $techn="HuggingFace TEI / Docker", $descr="Container HuggingFace TEI phục vụ sinh vector nhúng cục bộ tốc độ cao cho mô hình BGE-M3 / hash", $tags="Container", $link="")
  Container(OpenRAGPlatform.LocalLLMServerTùychọn, "Local LLM Server (Tùy chọn)", $techn="Ollama", $descr="Chạy model LLM và embedding offline hoàn toàn trên máy chủ khi không kết nối API đám mây", $tags="Container", $link="")
  Container(OpenRAGPlatform.WebApplication, "Web Application", $techn="React 18, TypeScript, Tailwind CSS, Vite, Nginx", $descr="Giao diện người dùng: chat trực tiếp qua SSE, hiển thị trích dẫn bằng chứng, quản lý duyệt tài liệu và trực quan hóa bảng biểu phân tích", $tags="Container,WebBrowser", $link="")
  Container(OpenRAGPlatform.BackendAPIService, "Backend API Service", $techn="Python 3.12, FastAPI, SQLAlchemy (asyncpg), LiteLLM, Agno", $descr="Cung cấp REST & SSE API, xác thực JWT/MFA, phân quyền RBAC, điều phối Agentic RAG qua Agno, kiểm dịch upload và điều hướng sự kiện", $tags="Container", $link="")
}

Rel(Ngườidùng, OpenRAGPlatform.WebApplication, "Tương tác giao diện người dùng, upload tài liệu, đặt câu hỏi chat", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, OpenRAGPlatform.WebApplication, "Cấu hình hệ thống, quản lý tài liệu và mô hình", $techn="HTTPS", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.WebApplication, OpenRAGPlatform.BackendAPIService, "Gửi request REST API và duy trì kết nối SSE nhận streaming", $techn="JSON / SSE over HTTPS", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.RelationalDatabase, "Đọc/ghi metadata, users, workspaces, sessions, bằng chứng và outbox", $techn="asyncpg / TCP 5432", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.MessageBrokerCache, "Đẩy tác vụ vào hàng đợi Celery, kiểm tra rate limit", $techn="Redis Protocol / TCP 6379", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.TransactionalEventStore, "Ghi nhận sự kiện nghiệp vụ vào Redis Streams outbox", $techn="Redis RESP / TCP 6379", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.ObjectStorage, "Lưu file vào vùng cách ly (quarantine), tải file đã duyệt", $techn="S3 API / HTTP 9000", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.VectorDatabase, "Truy vấn hybrid search (dense + BM25) với bộ lọc tenant cứng", $techn="HTTP / REST 6333", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Sinh vector embedding câu truy vấn tức thì", $techn="HTTP 80", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, LLMVLMProvider, "Gọi mô hình sinh câu trả lời, lập kế hoạch Agno qua LiteLLM", $techn="HTTPS", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.MessageBrokerCache, "Nhận tác vụ Celery từ hàng đợi ingestion, models, evaluations", $techn="Redis Protocol", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.RelationalDatabase, "Cập nhật trạng thái tài liệu, ghi nhận kết quả đánh giá, chunk metadata", $techn="asyncpg", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.ObjectStorage, "Đọc file từ vùng cách ly, lưu file đã xử lý", $techn="S3 API", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Sinh vector embedding hàng loạt cho các chunk", $techn="HTTP", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.VectorDatabase, "Upsert điểm vector kèm payload ngữ cảnh và bằng chứng", $techn="HTTP / gRPC", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, LLMVLMProvider, "Chạy probe kiểm tra năng lực mô hình, đánh giá benchmark", $techn="HTTPS", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryBeatScheduler, OpenRAGPlatform.MessageBrokerCache, "Lập lịch định kỳ đẩy tác vụ dọn dẹp, kiểm tra vào hàng đợi", $techn="Redis Protocol", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.EventWorker, OpenRAGPlatform.TransactionalEventStore, "Đọc sự kiện từ Redis Streams consumer group", $techn="Redis RESP", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.EventWorker, OpenRAGPlatform.RelationalDatabase, "Cập nhật trạng thái vòng đời sự kiện idempotent", $techn="asyncpg", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService, ObservabilityPlatform, "Gửi OpenTelemetry traces và metrics", $techn="OTLP / gRPC", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, ObservabilityPlatform, "Gửi OpenTelemetry traces quá trình nạp và đánh giá", $techn="OTLP / gRPC", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.MessageBrokerCache, OpenRAGPlatform.CeleryWorkerFleet, "Phân phối tác vụ Celery", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.BackendAPIService, "Gọi LiteLLM thăm dò năng lực", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
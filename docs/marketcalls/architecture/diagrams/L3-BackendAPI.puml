@startuml
title <size:24>Component View: OpenRAG Platform - Backend API Service</size>\n<size:24>Level 3 - Component: Backend API Service</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

AddElementTag("Component", $bgColor="#85bbf0", $borderColor="#5d82a8", $fontColor="#000000", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,WebBrowser", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Container", $bgColor="#ffffff", $borderColor="#2e6295", $fontColor="#2e6295", $shadowing="", $borderStyle="solid")

System(LLMVLMProvider, "LLM / VLM Provider", $descr="Cung cấp mô hình ngôn ngữ lớn (OpenAI GPT-5.6, Azure OpenAI, Anthropic, Bedrock, vLLM, Ollama) qua thư viện LiteLLM nhúng trong tiến trình", $tags="Software System,External", $link="")

System_Boundary("OpenRAGPlatform_boundary", "OpenRAG Platform", $tags="Software System") {
  Container_Boundary("OpenRAGPlatform.BackendAPIService_boundary", "Backend API Service", $tags="Container") {
    Component(OpenRAGPlatform.BackendAPIService.AuthRBACController, "Auth & RBAC Controller", $techn="FastAPI Router, Pydantic, Passlib", $descr="Đăng nhập, cấp JWT, quản lý phiên làm việc, lời mời thành viên và phân quyền vai trò (Superadmin, Org Admin, Workspace Member)", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.DocumentQuarantineController, "Document & Quarantine Controller", $techn="FastAPI Router", $descr="Xử lý tải file vào vùng cách ly kiểm duyệt, phê duyệt nạp, tra cứu trạng thái và xóa tài liệu", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.ChatSSEStreamingController, "Chat & SSE Streaming Controller", $techn="FastAPI Router, Starlette StreamingResponse", $descr="Tiếp nhận câu hỏi, mở luồng Server-Sent Events (SSE) phát token, trích dẫn bằng chứng và trạng thái thời gian thực", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.AgnoAgenticOrchestrator, "Agno Agentic Orchestrator", $techn="Agno Framework, Python", $descr="Điều phối vòng lặp tác tử (agent loop) tự động lập kế hoạch truy vấn, giới hạn tối đa 4 lượt gọi công cụ đọc an toàn (bounded read-only tools)", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, "Hybrid Retrieval Engine", $techn="Python, Qdrant Client", $descr="Tìm kiếm kết hợp dense vector và sparse BM25 trên Qdrant, áp bộ lọc tenant cứng, lấy chunk lân cận và xếp hạng lại", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.EvidenceGroundingValidator, "Evidence & Grounding Validator", $techn="Python Domain Logic", $descr="Đối chiếu bằng chứng truy xuất trong PostgreSQL, kiểm tra tính xác thực của số trang/tiêu đề và từ chối nếu thiếu căn cứ", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.AnalyticsArtifactEngine, "Analytics Artifact Engine", $techn="Python Schema, Vega-Lite", $descr="Sinh bổ sung biểu đồ Vega-Lite và bảng dữ liệu an toàn theo hợp đồng analytics.v1 khi câu hỏi yêu cầu phân tích số liệu", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.ModelGatewayProber, "Model Gateway & Prober", $techn="LiteLLM in-process, Pydantic", $descr="Đóng gói thư viện LiteLLM, quản lý danh mục mô hình, thực hiện probe kiểm tra năng lực (streaming, structured output, vision, tools)", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.EnvelopeEncryptionVault, "Envelope Encryption Vault", $techn="Cryptography Fernet/AES-GCM", $descr="Mã hóa khóa API nhà cung cấp bằng cơ chế envelope encryption (Master KEK file + DEK per secret)", $tags="Component", $link="")
    Component(OpenRAGPlatform.BackendAPIService.TransactionalOutboxDispatcher, "Transactional Outbox Dispatcher", $techn="SQLAlchemy asyncpg", $descr="Ghi nhận sự kiện vào bảng outbox và đẩy vào Redis Streams đồng bộ với transaction cơ sở dữ liệu", $tags="Component", $link="")
  }

  Container(OpenRAGPlatform.CeleryWorkerFleet, "Celery Worker Fleet", $techn="Python 3.12, Celery, Docling, RapidOCR, LiteLLM", $descr="Cụm worker nền đa hàng đợi: xử lý trích xuất Docling/OCR, chia chunk, sinh embedding, đánh giá golden dataset và thăm dò model", $tags="Container", $link="")
  ContainerDb(OpenRAGPlatform.RelationalDatabase, "Relational Database", $techn="PostgreSQL 16 Alpine", $descr="Lưu trữ metadata tài liệu, tổ chức, workspace, tài khoản người dùng, bảng phân quyền RBAC, phiên chat, bằng chứng trích dẫn và khóa mã hóa", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.TransactionalEventStore, "Transactional Event Store", $techn="Redis 7.4 Alpine (Streams, AOF always)", $descr="Lưu trữ luồng sự kiện bền vững qua Redis Streams với cơ chế append-only file (AOF always)", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.ObjectStorage, "Object Storage", $techn="MinIO (S3 compatible)", $descr="Lưu trữ tài liệu gốc, vùng cách ly kiểm duyệt file (quarantine), và dữ liệu xuất báo cáo", $tags="Container,Database", $link="")
  ContainerDb(OpenRAGPlatform.VectorDatabase, "Vector Database", $techn="Qdrant Vector DB", $descr="Lưu trữ vector dense và sparse BM25, hỗ trợ tìm kiếm kết hợp (hybrid search) với bộ lọc cứng cô lập tenant theo org_id và workspace_id", $tags="Container,Database", $link="")
  Container(OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Text Embeddings Inference (TEI)", $techn="HuggingFace TEI / Docker", $descr="Container HuggingFace TEI phục vụ sinh vector nhúng cục bộ tốc độ cao cho mô hình BGE-M3 / hash", $tags="Container", $link="")
  Container(OpenRAGPlatform.WebApplication, "Web Application", $techn="React 18, TypeScript, Tailwind CSS, Vite, Nginx", $descr="Giao diện người dùng: chat trực tiếp qua SSE, hiển thị trích dẫn bằng chứng, quản lý duyệt tài liệu và trực quan hóa bảng biểu phân tích", $tags="Container,WebBrowser", $link="")
}

Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, "Truy xuất đối chiếu Simple RAG vs Agentic RAG", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.RelationalDatabase, "Cập nhật trạng thái tài liệu, ghi nhận kết quả đánh giá, chunk metadata", $techn="asyncpg", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.ObjectStorage, "Đọc file từ vùng cách ly, lưu file đã xử lý", $techn="S3 API", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Sinh vector embedding hàng loạt cho các chunk", $techn="HTTP", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.VectorDatabase, "Upsert điểm vector kèm payload ngữ cảnh và bằng chứng", $techn="HTTP / gRPC", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, LLMVLMProvider, "Chạy probe kiểm tra năng lực mô hình, đánh giá benchmark", $techn="HTTPS", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.WebApplication, OpenRAGPlatform.BackendAPIService.AuthRBACController, "Gửi thông tin đăng nhập, refresh token", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.WebApplication, OpenRAGPlatform.BackendAPIService.DocumentQuarantineController, "Upload file lên vùng cách ly, gửi yêu cầu duyệt/xóa", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.WebApplication, OpenRAGPlatform.BackendAPIService.ChatSSEStreamingController, "Gửi câu hỏi, mở kết nối nhận luồng SSE", $techn="HTTPS / SSE", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.ChatSSEStreamingController, OpenRAGPlatform.BackendAPIService.AgnoAgenticOrchestrator, "Khởi tạo vòng lặp tác tử, điều phối truy vấn", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.AgnoAgenticOrchestrator, OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, "Yêu cầu tìm kiếm kết hợp (hybrid retrieval) với bộ lọc cứng", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.AgnoAgenticOrchestrator, OpenRAGPlatform.BackendAPIService.ModelGatewayProber, "Gọi mô hình lập kế hoạch và sinh câu trả lời", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, OpenRAGPlatform.VectorDatabase, "Thực thi tìm kiếm vector dense + sparse", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, OpenRAGPlatform.TextEmbeddingsInferenceTEI, "Embed câu hỏi truy vấn", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.HybridRetrievalEngine, OpenRAGPlatform.RelationalDatabase, "Lấy chunk lân cận, nạp thông tin tài liệu", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.AgnoAgenticOrchestrator, OpenRAGPlatform.BackendAPIService.EvidenceGroundingValidator, "Xác minh bằng chứng và nguồn trích dẫn", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.EvidenceGroundingValidator, OpenRAGPlatform.RelationalDatabase, "Kiểm tra tính hợp lệ của PageBlock và Document Version", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.ChatSSEStreamingController, OpenRAGPlatform.BackendAPIService.AnalyticsArtifactEngine, "Sinh biểu đồ và bảng phân tích khi có yêu cầu analytics.v1", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.ChatSSEStreamingController, OpenRAGPlatform.RelationalDatabase, "Lưu phiên hội thoại và tin nhắn", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.DocumentQuarantineController, OpenRAGPlatform.ObjectStorage, "Lưu file vào thư mục quarantine", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.DocumentQuarantineController, OpenRAGPlatform.RelationalDatabase, "Tạo bản ghi tài liệu trạng thái PENDING_APPROVAL", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.DocumentQuarantineController, OpenRAGPlatform.BackendAPIService.TransactionalOutboxDispatcher, "Phát sinh sự kiện nạp tài liệu", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.TransactionalOutboxDispatcher, OpenRAGPlatform.RelationalDatabase, "Ghi sự kiện vào bảng outbox", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.TransactionalOutboxDispatcher, OpenRAGPlatform.TransactionalEventStore, "Đẩy sự kiện vào Redis Stream", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.ModelGatewayProber, OpenRAGPlatform.BackendAPIService.EnvelopeEncryptionVault, "Giải mã API key của nhà cung cấp", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.EnvelopeEncryptionVault, OpenRAGPlatform.RelationalDatabase, "Đọc bản ghi key đã mã hóa phong bì", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.BackendAPIService.ModelGatewayProber, LLMVLMProvider, "Gọi API mô hình qua LiteLLM", $techn="", $tags="Relationship", $link="")
Rel(OpenRAGPlatform.CeleryWorkerFleet, OpenRAGPlatform.BackendAPIService.ModelGatewayProber, "Gọi LiteLLM thăm dò năng lực", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
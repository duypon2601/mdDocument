@startuml
title <size:24>System Context View: RAG Starter System</size>\n<size:24>Level 1 - System Context: RAG Starter System</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

AddElementTag("Software System", $bgColor="#1168bd", $borderColor="#0b4884", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

Person(Ngườidùng, "Người dùng", $descr="Đăng ký/đăng nhập tài khoản, tải lên tài liệu, tra cứu và hỏi đáp qua chat có trích dẫn nguồn", $tags="Person", $link="")
Person(Quảntrịviên, "Quản trị viên", $descr="Quản lý dữ liệu qua Django Admin (/admin), kiểm tra probe sức khỏe (/api/health), theo dõi LLM trace", $tags="Person", $link="")
System(LLMVLMProvider, "LLM / VLM Provider", $descr="Cung cấp model sinh câu trả lời, nhận diện ngôn ngữ, rephrase câu hỏi và tóm tắt trang (OpenAI, Azure, OpenRouter, vLLM hoặc Ollama)", $tags="Software System,External", $link="")
System(EmbeddingProvider, "Embedding Provider", $descr="Tạo vector nhúng ngữ nghĩa (OpenAI text-embedding-3-small, FastEmbed, hoặc Ollama nomic-embed-text)", $tags="Software System,External", $link="")
System(Nguồntàiliệutừxa, "Nguồn tài liệu từ xa", $descr="Trích xuất nội dung từ Website (sitemap XML) hoặc không gian Atlassian Confluence", $tags="Software System,External", $link="")
System(LangfuseObservability, "Langfuse Observability", $descr="Thu thập trace LLM, đo lường chi phí, token usage và đánh giá chất lượng prompt", $tags="Software System,External", $link="")
System(RAGStarterSystem, "RAG Starter System", $descr="Hệ thống RAG mã nguồn mở monorepo (Django + Next.js), xử lý ingestion đa định dạng và hỏi đáp thông minh có trích dẫn nguồn", $tags="Software System", $link="")

Rel(Ngườidùng, RAGStarterSystem, "Upload tài liệu, trò chuyện tra cứu, xem trích dẫn nguồn", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, RAGStarterSystem, "Quản trị dữ liệu qua Django admin, kiểm tra health probe", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RAGStarterSystem, LLMVLMProvider, "Gửi prompt chat, rephrase câu hỏi, tóm tắt trang, caption ảnh", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem, EmbeddingProvider, "Tạo dense vector embeddings", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem, Nguồntàiliệutừxa, "Tải trang web, sitemap XML, bài viết Confluence", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem, LangfuseObservability, "Gửi telemetry trace, token usage và cost", $techn="HTTPS / OTLP", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
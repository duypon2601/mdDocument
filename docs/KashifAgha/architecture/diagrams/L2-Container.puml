@startuml
title <size:24>Container View: RAG Starter System</size>\n<size:24>Level 2 - Container: RAG Starter System</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#8c8c8c", $borderColor="#626262", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,WebBrowser", $bgColor="#014f86", $borderColor="#00375d", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container,Database", $bgColor="#2a6f97", $borderColor="#1d4d69", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Ngườidùng, "Người dùng", $descr="Đăng ký/đăng nhập tài khoản, tải lên tài liệu, tra cứu và hỏi đáp qua chat có trích dẫn nguồn", $tags="Person", $link="")
Person(Quảntrịviên, "Quản trị viên", $descr="Quản lý dữ liệu qua Django Admin (/admin), kiểm tra probe sức khỏe (/api/health), theo dõi LLM trace", $tags="Person", $link="")
System(LLMVLMProvider, "LLM / VLM Provider", $descr="Cung cấp model sinh câu trả lời, nhận diện ngôn ngữ, rephrase câu hỏi và tóm tắt trang (OpenAI, Azure, OpenRouter, vLLM hoặc Ollama)", $tags="Software System,External", $link="")
System(EmbeddingProvider, "Embedding Provider", $descr="Tạo vector nhúng ngữ nghĩa (OpenAI text-embedding-3-small, FastEmbed, hoặc Ollama nomic-embed-text)", $tags="Software System,External", $link="")
System(Nguồntàiliệutừxa, "Nguồn tài liệu từ xa", $descr="Trích xuất nội dung từ Website (sitemap XML) hoặc không gian Atlassian Confluence", $tags="Software System,External", $link="")
System(LangfuseObservability, "Langfuse Observability", $descr="Thu thập trace LLM, đo lường chi phí, token usage và đánh giá chất lượng prompt", $tags="Software System,External", $link="")

System_Boundary("RAGStarterSystem_boundary", "RAG Starter System", $tags="Software System") {
  Container(RAGStarterSystem.IngestionWorker, "Ingestion Worker", $techn="Python 3.13, Celery (concurrency=1), Docling, MarkItDown, pypdf", $descr="Thực thi trích xuất file (Docling/MarkItDown), chunking, tóm tắt trang qua LLM, sinh embedding và upsert vào Vector DB", $tags="Container", $link="")
  Container(RAGStarterSystem.CeleryBeatScheduler, "Celery Beat Scheduler", $techn="Python 3.13, Celery Beat", $descr="Định kỳ quét và dọn dẹp các tài liệu bị kẹt ở trạng thái PROCESSING (reap_stuck_documents)", $tags="Container", $link="")
  ContainerDb(RAGStarterSystem.RelationalDatabase, "Relational Database", $techn="PostgreSQL 17", $descr="Lưu trữ tài khoản người dùng, metadata tài liệu, chunks, lịch sử hội thoại và tin nhắn chat", $tags="Container,Database", $link="")
  ContainerDb(RAGStarterSystem.MessageBrokerCache, "Message Broker & Cache", $techn="Redis 7", $descr="Hàng đợi tác vụ Celery, bộ đếm số lần worker lost và cache chia sẻ", $tags="Container,Database", $link="")
  ContainerDb(RAGStarterSystem.ObjectStorage, "Object Storage", $techn="MinIO (S3 compatible)", $descr="Lưu trữ file tài liệu gốc tải lên, phục vụ tải về và đối chiếu trích dẫn nguồn", $tags="Container,Database", $link="")
  ContainerDb(RAGStarterSystem.VectorDatabase, "Vector Database", $techn="Qdrant 1.12", $descr="Lưu trữ hybrid vectors (dense + BM25 sparse) và payload, phân vùng dữ liệu theo tenant (owner_id)", $tags="Container,Database", $link="")
  Container(RAGStarterSystem.LocalLLMServerTùychọn, "Local LLM Server (Tùy chọn)", $techn="Ollama", $descr="Chạy model LLM và Embedding offline trên máy chủ khi bật profile local-llm", $tags="Container", $link="")
  Container(RAGStarterSystem.WebApplication, "Web Application", $techn="Next.js 16, React 19, TypeScript, Tailwind CSS", $descr="Giao diện chat trực tuyến, quản lý upload tài liệu, hiển thị trích dẫn nguồn và SSE streaming", $tags="Container,WebBrowser", $link="")
  Container(RAGStarterSystem.BackendAPIService, "Backend API Service", $techn="Python 3.13, Django 5.1, DRF, Gunicorn, LangChain, LangGraph", $descr="Cung cấp REST API, xác thực JWT, điều phối LangGraph, stream SSE và quản lý CRUD tài liệu", $tags="Container", $link="")
}

Rel(Ngườidùng, RAGStarterSystem.WebApplication, "Truy cập giao diện web, chat, upload file", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, RAGStarterSystem.WebApplication, "Đăng nhập giao diện web", $techn="HTTPS", $tags="Relationship", $link="")
Rel(Quảntrịviên, RAGStarterSystem.BackendAPIService, "Quản trị qua /admin/, kiểm tra /api/health/", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RAGStarterSystem.WebApplication, RAGStarterSystem.BackendAPIService, "Gọi REST API, stream SSE /api/chat/ask/", $techn="HTTPS / JWT", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, RAGStarterSystem.RelationalDatabase, "Lưu/đọc users, documents, chunks, chat history", $techn="SQL (TCP 5432)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, RAGStarterSystem.MessageBrokerCache, "Đẩy tác vụ ingest vào queue, đọc/ghi cache", $techn="Redis protocol (TCP 6379)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, RAGStarterSystem.ObjectStorage, "Lưu file upload ban đầu, tạo presigned URL tải file", $techn="S3 API (TCP 9000)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, RAGStarterSystem.VectorDatabase, "Truy vấn hybrid search (dense + BM25 sparse) kèm filter owner_id", $techn="HTTP/gRPC (TCP 6333)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, LLMVLMProvider, "Gọi LLM suy luận, rephrase, generate câu trả lời", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, EmbeddingProvider, "Tạo embedding câu hỏi", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, LangfuseObservability, "Gửi trace LangChain & LangGraph", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RAGStarterSystem.BackendAPIService, RAGStarterSystem.LocalLLMServerTùychọn, "Gọi model offline khi chạy local-llm profile", $techn="HTTP (TCP 11434)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.MessageBrokerCache, "Lắng nghe nhận task ingest/enrich, kiểm tra worker-loss count", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.RelationalDatabase, "Cập nhật trạng thái UPLOADING → PROCESSING → READY | ERROR, lưu metadata chunks", $techn="SQL", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.ObjectStorage, "Đọc file gốc để trích xuất văn bản", $techn="S3 API", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.VectorDatabase, "Upsert hybrid vectors và chunk payload kèm owner_id", $techn="HTTP/gRPC", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, Nguồntàiliệutừxa, "Cào website, tải sitemap, gọi Confluence API", $techn="HTTPS", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, LLMVLMProvider, "Gọi LLM tóm tắt từng trang và VLM chú thích ảnh", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, EmbeddingProvider, "Tạo dense embedding cho từng chunk", $techn="HTTPS / REST", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.LocalLLMServerTùychọn, "Tạo embedding và LLM summary offline khi chạy local-llm profile", $techn="HTTP (TCP 11434)", $tags="Relationship", $link="")
Rel(RAGStarterSystem.CeleryBeatScheduler, RAGStarterSystem.MessageBrokerCache, "Đẩy tác vụ định kỳ reap_stuck_documents", $techn="Redis protocol", $tags="Relationship", $link="")
Rel(RAGStarterSystem.MessageBrokerCache, RAGStarterSystem.IngestionWorker, "Nhận task ingest_document_task(doc_id)", $techn="Celery", $tags="Relationship", $link="")
Rel(RAGStarterSystem.IngestionWorker, RAGStarterSystem.BackendAPIService, "Cập nhật Document status sang PROCESSING", $techn="ORM", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml